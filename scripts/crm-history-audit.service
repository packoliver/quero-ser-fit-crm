[Unit]
Description=CRM - Auditoria retomavel do historico de vendas
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/docker run --rm --name crm-history-audit --env-file /opt/crm-history-audit/worker.env --mount type=bind,source=/opt/crm-history-audit/runner.mjs,target=/app/runner.mjs,readonly --read-only --user 1000:1000 --security-opt no-new-privileges --cap-drop ALL --memory 256m --cpus 0.5 --pids-limit 64 node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 node /app/runner.mjs --watch
ExecStop=-/usr/bin/docker stop -t 240 crm-history-audit
TimeoutStopSec=270
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
