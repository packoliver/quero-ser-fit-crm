# Configuração do Supabase (Público no Cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (Privado no Servidor - NUNCA expor ao cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Conectores Oficiais da Meta (Privado no Servidor)
META_WEBHOOK_VERIFY_TOKEN=your-random-meta-verify-token-here
META_APP_SECRET=your-meta-app-secret-from-developers-console-here

# Chave de Criptografia AES-256 para Tokens Salvos no Banco (Privado no Servidor)
# Deve ser uma string aleatória com 32 caracteres exatamente
INTEGRATION_ENCRYPTION_KEY=32_bytes_random_encryption_key_here

# Conector WhatsApp via zap-api.tech (Privado no Servidor)
# Gere um valor aleatório longo. O app usa esse mesmo valor para (a) registrar o
# webhook automaticamente em cada instância ao cadastrar a conexão, e (b) verificar a
# assinatura HMAC-SHA256 (header x-zapapi-signature-256) das chamadas recebidas em
# /api/webhooks/zapapi.
ZAPAPI_WEBHOOK_SECRET=your-random-long-secret-here
