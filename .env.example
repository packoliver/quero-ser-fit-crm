# Configuração do Supabase (Público no Cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (Privado no Servidor - NUNCA expor ao cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Conectores Oficiais da Meta (Privado no Servidor)
META_APP_ID=your-meta-app-id-from-developers-console-here
META_APP_SECRET=your-meta-app-secret-from-developers-console-here
META_WEBHOOK_VERIFY_TOKEN=your-random-meta-verify-token-here
META_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/integrations/meta/oauth/callback
META_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages

# O campo META_APP_ID identifica qual aplicativo Meta o CRM deve usar.
# Nunca coloque META_APP_SECRET no navegador ou em variáveis NEXT_PUBLIC_.

# Chave de Criptografia AES-256 para Tokens Salvos no Banco (Privado no Servidor)
# Deve ser uma string aleatória com 32 caracteres exatamente
INTEGRATION_ENCRYPTION_KEY=32_bytes_random_encryption_key_here

# Web Push (VAPID). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@queroserfit.com.br
