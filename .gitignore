# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# ffmpeg-core.wasm (~32MB) é copiado de node_modules/@ffmpeg/core pelo script
# postinstall (scripts/copy-ffmpeg-core.js) — não faz sentido versionar um binário
# grande que já vem de uma dependência do package.json.
/public/ffmpeg/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
